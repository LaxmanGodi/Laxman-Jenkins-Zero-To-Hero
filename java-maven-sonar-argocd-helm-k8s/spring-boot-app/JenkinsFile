pipeline {
  agent {
    docker {
      image 'laxmangodi/maven-laxman-docker-agent:v1'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock' // mount Docker socket to access the host's Docker daemon
    }
  }
  stages {
    stage('Checkout') {
      steps {
        sh 'echo passed'
        //git branch: 'main', url: 'https://github.com/LaxmanGodi/Laxman-Jenkins-Zero-To-Hero'
      }
    }
    stage('Build and Test') {
      steps {
        sh 'ls -ltr'
        // build the project and create a JAR file
        sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn clean package'
      }
    }

    stage('Diagnostics') {
      steps {
        sh '''#!/bin/bash
          java -version
          mvn -version
          mvn help:effective-pom || true
        '''
      }
    }

    stage('Static Code Analysis') {
      environment {
        SONAR_URL = "http://172.17.0.1:9000"
      }
      steps {
        withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
          sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn sonar:sonar -Dsonar.login=${SONAR_AUTH_TOKEN} -Dsonar.host.url=${SONAR_URL}'
        }
      }
    }

      stage('Build Docker Image') {
        environment { DOCKER_IMAGE = "laxmangodi/ultimate-cicd:${BUILD_NUMBER}" }
        steps {
          // Navigate to the folder first, then build using the local Dockerfile
          sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && docker build -t ${DOCKER_IMAGE} .'
        }
      }

stage('Trivy Security Scan') {
    environment {
        DOCKER_IMAGE = "laxmangodi/ultimate-cicd:${BUILD_NUMBER}"
        // Trivy uses /tmp for extracting layers. Ensure this directory is large enough 
        // or redirect it to a path with more space if this still fails.
        TMPDIR = "${WORKSPACE}/tmp"
    }
    steps {
        sh """
            mkdir -p ${WORKSPACE}/.trivy_cache ${WORKSPACE}/tmp
            
            # 1. Ensure DB is already there (downloaded in previous successful runs)
            # 2. --timeout 20m: Increases total scan time to 20 minutes
            # 3. --parallel 1: Reduces CPU/Disk thrashing by scanning layers sequentially
            # 4. --scanners vuln: Limits scan to vulnerabilities only (skips secrets/misconfig)
            
            echo "Starting scan for ${DOCKER_IMAGE}..."
            docker run --rm \
                -e TMPDIR=/tmp \
                -v ${WORKSPACE}/.trivy_cache:/root/.cache/ \
                -v /var/run/docker.sock:/var/run/docker.sock \
                aquasec/trivy:latest image \
                --timeout 20m \
                --parallel 1 \
                --scanners vuln \
                --skip-db-update \
                --skip-java-db-update \
                --severity HIGH,CRITICAL \
                --exit-code 1 \
                ${DOCKER_IMAGE}
        """
    }
}
    stage('Push Docker Image') {
      environment {
        DOCKER_IMAGE = "laxmangodi/ultimate-cicd:${BUILD_NUMBER}"
      }
      steps {
        script {
          docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {
            docker.image("${DOCKER_IMAGE}").push()
          }
        }
      }
    }

    stage('Update Deployment File') {
      environment {
        GIT_REPO_NAME = "Laxman-Jenkins-Zero-To-Hero"
        GIT_USER_NAME = "LaxmanGodi"
      }
      steps {
        withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
          sh """#!/bin/bash
            git config --global --add safe.directory '*'
            git config user.email "godilaxman470@gmail.com"
            git config user.name "${GIT_USER_NAME}"
            sed -i "s|image: .*|image: laxmangodi/ultimate-cicd:${BUILD_NUMBER}|g" java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
            git add .
            git commit -m "Update deployment image to version ${BUILD_NUMBER} [skip ci]" || true
            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:main
          """
        }
      }
    }
    stage('Cleanup') {
      steps {
        cleanWs() // Deletes the workspace before starting a new build
      }
    }
  }
}
